#compdef sh-agent -ask -act -model -provider -personality -usage -custom -history -help -update

local curcontext="$curcontext" state line ret=1

_sh_agent_model_args() {
  _values 'model option' 'refresh[refresh provider model cache]'
}

_sh_agent_personality_args() {
  _values 'personality option' 'edit[open custom personality file in $VISUAL or $EDITOR]'
}

case "$words[1]" in
  -ask|-act)
    _message 'prompt text'
    ret=0
    ;;
  -model)
    _sh_agent_model_args
    ret=$?
    ;;
  -personality)
    _sh_agent_personality_args
    ret=$?
    ;;
  -provider|-usage|-custom|-history|-help|-update)
    _message 'no arguments'
    ret=0
    ;;
  sh-agent)
    if (( CURRENT == 2 )); then
      _values 'command' \
        'ask[read-only agent]' \
        'act[editing agent]' \
        'model[choose model]' \
        'provider[choose provider]' \
        'personality[choose response personality]' \
        'usage[show usage]' \
        'custom[customize UI]' \
        'history[show recent sessions]' \
        'help[show help]' \
        'update[pull and rebuild latest version]'
      ret=$?
    else
      case "$words[2]" in
        ask|act)
          _message 'prompt text'
          ret=0
          ;;
        model)
          _sh_agent_model_args
          ret=$?
          ;;
        personality)
          _sh_agent_personality_args
          ret=$?
          ;;
        provider|usage|custom|history|help|update)
          _message 'no arguments'
          ret=0
          ;;
      esac
    fi
    ;;
esac

return ret
